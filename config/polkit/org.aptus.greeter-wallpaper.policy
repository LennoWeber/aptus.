<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD polkit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <action id="org.aptus.greeter-wallpaper">
    <description>Change the aptus login screen picture</description>
    <message>Authentication is required to change the login screen picture</message>
    <!-- The shell keeps the login picture in step with the desktop wallpaper, so the active local session may do it without a password.
         The helper reads the picture with the caller's own rights and checks type and size; other sessions still need an admin. -->
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/bin/aptus-greeter-wallpaper</annotate>
  </action>
</policyconfig>

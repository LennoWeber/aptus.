        "bg": "#101A15", "surface": "#17241D", "surfaceAlt": "#1F3027", "line": "#2D4338",
        "ink": "#E4EFE8", "inkSoft": "#A3B8AB", "inkFaint": "#6B8174",
        "ok": "#4FC3A1", "warn": "#E3B45C", "critical": "#EE7B6E",

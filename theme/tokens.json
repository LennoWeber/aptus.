{
  "name": "aptus",
  "bar": { "height": 28 },
  "palette": {
    "day": {
      "bg": "#F4F3EF",
      "surface": "#FBFAF7",
      "surfaceAlt": "#ECEAE4",
      "line": "#D9D6CE",
      "ink": "#1C2127",
      "inkSoft": "#5A616B",
      "inkFaint": "#8D939B",
      "ok": "#1F6B4F",
      "warn": "#B7791F",
      "critical": "#B3382C"
    },
    "night": {
      "bg": "#F3EEE2",
      "surface": "#FAF5E9",
      "surfaceAlt": "#EBE4D3",
      "line": "#D6CDB8",
      "ink": "#27231D",
      "inkSoft": "#645C4F",
      "inkFaint": "#968D7D",
      "ok": "#2A6A4A",
      "warn": "#B06F1A",
      "critical": "#AE3A2B"
    },
    "colorRule": "Neutral by default. ok/warn/critical appear only to signal state (active, attention, critical). Never decorative."
  },
  "blur": {
    "overlayDim": 0.18,
    "radius": 18,
    "appliesTo": ["controlCenter", "launcher"]
  },
  "radius": { "window": 10, "dropdown": 10, "tile": 16, "pill": 999, "bar": 0 },
  "spacing": { "xs": 4, "sm": 8, "md": 12, "lg": 20, "xl": 32 },
  "border": { "hairline": 1 },
  "motion": {
    "easing": [0.2, 0.0, 0.0, 1.0],
    "fast": 140,
    "slow": 260,
    "feedbackBudgetMs": 50
  },
  "font": {
    "ui": "Inter",
    "mono": "JetBrains Mono",
    "size": { "bar": 12, "body": 13, "title": 18, "display": 32 },
    "numbers": "tabular"
  }
}

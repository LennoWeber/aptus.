{
  "name": "aptus",
  "bar": { "height": 28 },
  "palette": {
    "day": {
      "bg": "#F4F3EF",
      "surface": "#FBFAF7",
      "surfaceAlt": "#ECEAE4",
      "line": "#D9D6CE",
      "ink": "#1C2127",
      "inkSoft": "#5A616B",
      "inkFaint": "#8D939B",
      "ok": "#1F6B4F",
      "warn": "#B7791F",
      "critical": "#B3382C"
    },
    "night": {
      "bg": "#F3EEE2",
      "surface": "#FAF5E9",
      "surfaceAlt": "#EBE4D3",
      "line": "#D6CDB8",
      "ink": "#27231D",
      "inkSoft": "#645C4F",
      "inkFaint": "#968D7D",
      "ok": "#2A6A4A",
      "warn": "#B06F1A",
      "critical": "#AE3A2B"
    },
    "dark": {
      "note": "Dark set for the apps (aptus-theme-apps --mode dark), not the shell. Same roles as day; bg equals day.ink and ink equals day.bg, keep them in sync. Keys named note are not colours.",
      "bg": "#1C2127",
      "surface": "#252B32",
      "surfaceAlt": "#2E353D",
      "line": "#3A424B",
      "ink": "#F4F3EF",
      "inkSoft": "#B4B9C0",
      "inkFaint": "#7C838C",
      "ok": "#6FBF9A",
      "warn": "#E0B35A",
      "critical": "#E0786C"
    },
    "accents": {
      "note": "Quiet fixed hues for syntax and links in apps (the shell itself has no accent). Never used for state. All colours are #RRGGBB; apps that need alpha or no # convert them when writing.",
      "light": { "blue": "#2B6CA3", "magenta": "#8B4C8F", "cyan": "#247B80", "bblue": "#3F82BA", "bmagenta": "#A062A5", "bcyan": "#34929A" },
      "dark": { "blue": "#7FB2E0", "magenta": "#C79BD0", "cyan": "#6FC7CC", "bblue": "#9CC6EA", "bmagenta": "#D8B3E0", "bcyan": "#8ED7DB" }
    },
    "modes": { "light": "day", "dark": "dark", "note": "aptus-theme-apps --mode maps to these palettes; night is the warm day variant and is not an app mode." },
    "brights": {
      "note": "Bright terminal variants of ok/warn/critical per mode.",
      "light": { "critical": "#C8493B", "ok": "#2F8A66", "warn": "#C98A2A" },
      "dark": { "critical": "#F09284", "ok": "#8AD3B0", "warn": "#EFC574" }
    },
    "roles": {
      "note": "Which palette key an app uses for a role, so every app agrees. Values are keys of the mode palette or of accents.",
      "selection": { "bg": "ink", "fg": "bg" },
      "link": "blue",
      "syntax": {
        "light": { "keyword": "magenta", "function": "blue", "string": "cyan", "type": "inkSoft", "number": "blue", "constant": "cyan", "comment": "inkFaint", "operator": "inkSoft" },
        "dark": { "keyword": "magenta", "function": "blue", "string": "cyan", "type": "bmagenta", "number": "bblue", "constant": "bcyan", "comment": "inkFaint", "operator": "inkSoft" }
      },
      "cavaGradient": ["inkFaint", "inkSoft", "ink"]
    },
    "colorRule": "Neutral by default. ok/warn/critical appear only to signal state (active, attention, critical). Never decorative."
  },
  "themeStyles": {
    "note": "Parameters of the colour styles. Hue targets in degrees, s and l in percent (HSL). A style turns the colours of the source (picture or fallbackColors) into the shell colours. ok, warn and critical stay fixed so they read on every picture.",
    "watercolor": {
      "hueTarget": 205, "hueShiftBase": 0.12, "hueShiftWash": 0.10,
      "washSatScale": 0.45, "washSatCap": 36, "washLightness": 87,
      "paper": { "s": 10, "l": 94 }, "surface": { "s": 14, "l": 97 }, "line": { "s": 10, "l": 82 },
      "ink": { "s": 28, "l": 18 }, "inkSoft": { "s": 16, "l": 32 }, "inkFaint": { "s": 10, "l": 58 },
      "selection": { "s": 28, "l": 84 },
      "barOffWhite": { "s": 12, "l": 96 }, "barTinted": { "s": 24, "l": 86 }, "barTintedInk": { "s": 28, "l": 18 },
      "barInkSoftMix": 0.15, "barInkFaintMix": 0.4,
      "glassAlpha": 0.72, "grain": "paper",
      "signal": { "ok": "#2F6B58", "warn": "#A66D15", "critical": "#A94A3C" },
      "fallbackColors": ["#A9B4A0", "#C2BBA8", "#9FB0B4", "#C9A99A"]
    },
    "oil": {
      "hueTarget": 35, "hueShiftBase": 0.25, "hueShiftWash": 0.20,
      "washSatScale": 0.50, "washSatCap": 44, "washLightness": 77,
      "paper": { "s": 24, "l": 88 }, "surface": { "s": 28, "l": 93 }, "line": { "s": 22, "l": 76 },
      "ink": { "s": 35, "l": 15 }, "inkSoft": { "s": 24, "l": 26 }, "inkFaint": { "s": 14, "l": 46 },
      "selection": { "s": 32, "l": 70 },
      "barOffWhite": { "s": 28, "l": 93 }, "barTinted": { "s": 26, "l": 30 }, "barTintedInk": { "s": 30, "l": 92 },
      "barInkSoftMix": 0.15, "barInkFaintMix": 0.4,
      "glassAlpha": 0.68, "grain": "weave",
      "signal": { "ok": "#35654A", "warn": "#A9661A", "critical": "#A5432F" },
      "fallbackColors": ["#8A8A5C", "#B3A27C", "#7E8F7B", "#B58368"]
    }
  },
  "themeExtraction": {
    "note": "How the colours are read from the wallpaper: ImageMagick scales the picture to sampleWidth, then every sampleStep-th pixel is clustered and four distinct colours are kept.",
    "sampleWidth": 96, "sampleStep": 1, "clusters": 6, "colors": 4,
    "minHueGapDeg": 14, "minLightnessGap": 14, "minSaturationForScore": 0.3
  },
  "blur": {
    "overlayDim": 0.18,
    "radius": 18,
    "appliesTo": ["controlCenter", "launcher"]
  },
  "radius": { "window": 10, "dropdown": 10, "tile": 16, "pill": 999, "bar": 0 },
  "spacing": { "xs": 4, "sm": 8, "md": 12, "lg": 20, "xl": 32 },
  "border": { "hairline": 1 },
  "motion": {
    "easing": [0.2, 0.0, 0.0, 1.0],
    "fast": 140,
    "slow": 260,
    "feedbackBudgetMs": 50
  },
  "font": {
    "ui": "Inter",
    "mono": "JetBrains Mono",
    "size": { "bar": 12, "body": 13, "title": 18, "display": 32 },
    "numbers": "tabular"
  }
}

      "accent": "#F4F3EF",
      "onAccent": "#1C2127",
      "on": "#6FBF9A"
    },
    "themes": {
      "note": "Colour themes besides light (day) and dark. Each is a complete palette with the roles of day plus accent (sliders, switches, meters, the active workspace), onAccent (text on the accent) and on (the on state of a switch), and base: light or dark. base decides everything that only knows light or dark (gsettings colour-scheme, prefers-color-scheme, icon variant). Optional accents (same keys as palette.accents) replace the syntax hues of the base. The theme wallpaper is generated by bin/aptus-wallpaper-theme into ~/.local/state/aptus/wallpaper-theme.json in the same shape. All colours are #RRGGBB.",
      "ocean": {
        "name": "Ocean", "base": "dark",
        "bg": "#0F1A24", "surface": "#162331", "surfaceAlt": "#1E2E3F", "line": "#2B3E52",
        "ink": "#E6EEF6", "inkSoft": "#A5B6C7", "inkFaint": "#6C7F92",

        "accent": "#1F6FD1", "onAccent": "#F6FAFD", "on": "#1F6FD1"
      }
    },
    "accents": {
      "note": "Quiet fixed hues for syntax and links in apps (the shell itself has no accent). Never used for state. All colours are #RRGGBB; apps that need alpha or no # convert them when writing.",
      "light": { "blue": "#2B6CA3", "magenta": "#8B4C8F", "cyan": "#247B80", "bblue": "#3F82BA", "bmagenta": "#A062A5", "bcyan": "#34929A" },
      "dark": { "blue": "#7FB2E0", "magenta": "#C79BD0", "cyan": "#6FC7CC", "bblue": "#9CC6EA", "bmagenta": "#D8B3E0", "bcyan": "#8ED7DB" }
    },
    "modes": { "light": "day", "dark": "dark", "note": "aptus-theme-apps --mode maps to these palettes; night is the warm day variant and is not an app mode." },
    "brights": {
      "note": "Bright terminal variants of ok/warn/critical per mode.",
      "light": { "critical": "#C8493B", "ok": "#2F8A66", "warn": "#C98A2A" },
      "dark": { "critical": "#F09284", "ok": "#8AD3B0", "warn": "#EFC574" }
    },
    "roles": {
      "note": "Which palette key an app uses for a role, so every app agrees. Values are keys of the mode palette or of accents.",
      "selection": { "bg": "ink", "fg": "bg" },
      "link": "blue",
      "syntax": {
        "light": { "keyword": "magenta", "function": "blue", "string": "cyan", "type": "inkSoft", "number": "blue", "constant": "cyan", "comment": "inkSoft", "operator": "ink" },
        "dark": { "keyword": "magenta", "function": "blue", "string": "cyan", "type": "bmagenta", "number": "bblue", "constant": "bcyan", "comment": "inkSoft", "operator": "ink" }
      },
      "cavaGradient": ["inkFaint", "inkSoft", "ink"]
    },
    "colorRule": "Neutral by default. ok/warn/critical appear only to signal state (active, attention, critical). Never decorative."
  },
  "blur": {
    "overlayDim": 0.18,
    "radius": 18,
    "appliesTo": ["controlCenter", "launcher"]
  },
  "radius": { "window": 10, "dropdown": 10, "tile": 16, "pill": 999, "bar": 0 },
  "spacing": { "xs": 4, "sm": 8, "md": 12, "lg": 20, "xl": 32 },
  "border": { "hairline": 1 },
  "motion": {
    "easing": [0.2, 0.0, 0.0, 1.0],
    "fast": 140,
    "slow": 260,
    "feedbackBudgetMs": 50
  },
  "font": {
    "ui": "Inter",
    "mono": "JetBrains Mono",
    "size": { "bar": 12, "body": 13, "title": 18, "display": 32 },
    "numbers": "tabular"
  }
}

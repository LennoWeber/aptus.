      "sky": {
        "name": "Sky", "base": "light",
        "bg": "#EAF1F8", "surface": "#F6FAFD", "surfaceAlt": "#DCE7F2", "line": "#C3D3E3",
        "ink": "#14263A", "inkSoft": "#4A6078", "inkFaint": "#7F93A8",

        "ok": "#6FCB9F", "warn": "#E5B567", "critical": "#EF7A8B",
        "accent": "#A294F9", "onAccent": "#120F1C", "on": "#A294F9"
      },
      "sand": {
        "name": "Sand", "base": "light",
        "bg": "#F3EBDD", "surface": "#FAF5EB", "surfaceAlt": "#E9DFCC", "line": "#D5C8B0",
        "ink": "#2B2118", "inkSoft": "#6A5B4A", "inkFaint": "#9C8E7A",
        "ok": "#3F7D58", "warn": "#A8680F", "critical": "#B03A2E",
        "accent": "#B4532A", "onAccent": "#FFF8EE", "on": "#B4532A"

# TODO(phase 7): register starship, fish, nvim, yazi, fastfetch, cava, hyprland_look, hyprlock, zen, thunderbird, spotify here and in the docstring
# line "--only" at the top of the file.
APPS = dict(kitty=kitty, ghostty=ghostty, btop=btop, gtk=gtk, qt=qt, zathura=zathura, gsettings=gsettings)


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--mode", choices=["light", "dark"], default="light")
    ap.add_argument("--dry-run", action="store_true")
    # TODO(phase 7): the default must stay the old apps; the new ones (Zen, Thunderbird, Spotify, anything inside the dotfiles links) only with --only or --all.
    ap.add_argument("--only", default=",".join(APPS))
    args = ap.parse_args()
    chosen = [a for a in args.only.split(",") if a]
    for a in chosen:
        if a not in APPS:
            print(f"unknown app {a}; known: {', '.join(APPS)}", file=sys.stderr)
            return 2
    p = palette(args.mode)
    # TODO(phase 7): after palette(): print check_contrast(colors_of(p, args.mode)) as warnings, and check template_roles of every template against colors_of before writing anything.
    for a in chosen:
        print(f"{a}:")
        APPS[a](p, args.mode, args.dry_run)
    # TODO(phase 7): reload_apps(chosen, args.dry_run) after the last app so running programs pick the colours up.
    return 0


sys.exit(main())

#!/usr/bin/env python3
"""Colour the apps of the dotfiles with the aptus palette.

  aptus-theme-apps [--mode light|dark] [--dry-run] [--only APP,...] [--all]

Default apps: kitty, ghostty, gtk, qt, btop, zathura, gsettings. With --only or --all also: starship, fish, nvim,
yazi, fastfetch, cava, hyprland_look (window borders), hyprlock, zen, thunderbird, spotify (a Spicetify theme).

Reads the palette in theme/tokens.json (day for light, dark for dark) and writes one theme file per app under
~/.config, filled from the templates in theme/apps. A config that does not mention the theme yet gets one line that
includes it. An existing file that is replaced is kept once as NAME.before-aptus (not inside linked folders: the
dotfiles repo is the backup there). Starship, nvim and fastfetch get their own files and are not edited. Nothing is installed or
applied: Spicetify needs `spicetify config current_theme aptus color_scheme Base && spicetify apply` once, and running programs read
their colours again only where they can (Hyprland, kitty, cava). Running it again rewrites the same files.
"""
import argparse
import contextlib
import json
import os
import re
import shutil
import subprocess
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
HOME = os.path.expanduser("~")
CFG = os.environ.get("XDG_CONFIG_HOME", os.path.join(HOME, ".config"))
STATE = os.environ.get("XDG_STATE_HOME", os.path.join(HOME, ".local", "state"))
# Fixed templates with {{role}} holes for the colours (one file per app part), filled by render_template.
TEMPLATES = os.path.join(ROOT, "theme", "apps")
# Colour files the shell and Hyprland read: aptus-look.lua loads HYPR_COLORS, hyprlock.conf sources HYPRLOCK_COLORS.
HYPR_COLORS = os.path.join(STATE, "aptus", "hyprland-colors.lua")
HYPRLOCK_COLORS = os.path.join(CFG, "hypr", "hyprlock-colors.conf")
# Window border and shadow are the ink with these alphas (the values aptus-look.lua used before).
BORDER_ALPHA_ACTIVE = 0.25
BORDER_ALPHA_INACTIVE = 0.094
SHADOW_ALPHA = 0.13
# Firefox-style profiles (Zen, Thunderbird): a folder with prefs.js below one of these roots is a profile.
ZEN_ROOT = os.path.join(CFG, "zen")
THUNDERBIRD_ROOTS = [os.path.join(HOME, ".thunderbird"), os.path.join(CFG, "thunderbird"),
                     os.path.join(HOME, ".var", "app", "org.mozilla.Thunderbird", ".thunderbird")]
# Spicetify keeps themes in SPICETIFY_DIR/NAME/{color.ini,user.css}; the theme is written even if Spicetify is not installed yet.
SPICETIFY_DIR = os.path.join(CFG, "spicetify", "Themes")
SPICETIFY_THEME = "aptus"
# Generated files for apps that cannot choose a colour set themselves.
MODE_FILE = os.path.join(STATE, "aptus", "color-mode")
FASTFETCH_CONFIG = os.path.join(CFG, "fastfetch", "aptus-config.jsonc")
GHOSTTY_THEMES = {"light": "aptus-light", "dark": "aptus-dark"}
YAZI_FLAVORS = {"light": "aptus-light", "dark": "aptus-dark"}
XSETTINGSD = os.path.join(CFG, "xsettingsd", "xsettingsd.conf")
_TOKENS = None
# Every palette of tokens.json has these keys; colours are always #RRGGBB.
PALETTE_KEYS = ("bg", "surface", "surfaceAlt", "line", "ink", "inkSoft", "inkFaint", "ok", "warn", "critical",
                "blue", "magenta", "cyan", "bblue", "bmagenta", "bcyan")
MODES = ("light", "dark")
HEX = re.compile(r"#[0-9A-Fa-f]{6}")

# Invariants of the constants: alphas are real alphas and the active border is stronger than the inactive one, the
# Spicetify theme name is one folder name. Target paths are checked where they are used, so a broken XDG variable
# stops only the apps that need it.
assert 0 < BORDER_ALPHA_INACTIVE < BORDER_ALPHA_ACTIVE <= 1 and 0 < SHADOW_ALPHA <= 1, "aptus-theme-apps: border and shadow alphas out of order"
assert os.sep not in SPICETIFY_THEME and SPICETIFY_THEME not in ("", ".", ".."), "aptus-theme-apps: Spicetify theme must be a plain folder name"


def palette(mode: str) -> dict:
    assert mode in MODES, f"unknown mode {mode}"
    t = load_tokens()["palette"]
    p = {k: v for k, v in t[t["modes"][mode]].items() if k != "note"}
    p.update({k: v for k, v in t["accents"][mode].items() if k != "note"})
    return p


def _lum(h: str) -> float:
    ch = [int(h.lstrip("#")[i:i + 2], 16) / 255 for i in (0, 2, 4)]
    ch = [c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4 for c in ch]
    return 0.2126 * ch[0] + 0.7152 * ch[1] + 0.0722 * ch[2]


def contrast_fit(color: str, bg: str, toward: str, ratio: float = 4.5) -> str:
    """Mix color toward `toward` in small steps until it has `ratio`:1 contrast on bg."""
    def cr(a, b):
        hi, lo = sorted((_lum(a), _lum(b)), reverse=True)
        return (hi + 0.05) / (lo + 0.05)
    c = [int(color.lstrip("#")[i:i + 2], 16) for i in (0, 2, 4)]
    t = [int(toward.lstrip("#")[i:i + 2], 16) for i in (0, 2, 4)]
    for step in range(21):
        k = step / 20
        out = "#%02X%02X%02X" % tuple(round(a + (b - a) * k) for a, b in zip(c, t))
        if cr(out, bg) >= ratio:
            return out
    return toward


def ansi(p: dict, mode: str) -> list:
    assert mode in MODES, f"unknown mode {mode}"
    b = load_tokens()["palette"]["brights"][mode]
    if mode == "light":
        # On a light ground "white" must stay readable: white/bright black become the soft ink, bright white the ink.
        # Every hue is pulled toward the ink until it reaches 4.5:1 on the background (WCAG AA for text).
        def fit(c):
            return contrast_fit(c, p["bg"], p["ink"])
        return [p["ink"], fit(p["critical"]), fit(p["ok"]), fit(p["warn"]), fit(p["blue"]), fit(p["magenta"]),
                fit(p["cyan"]), p["inkSoft"], p["inkSoft"], fit(b["critical"]), fit(b["ok"]), fit(b["warn"]),
                fit(p["bblue"]), fit(p["bmagenta"]), fit(p["bcyan"]), p["ink"]]
    return [p["surface"], p["critical"], p["ok"], p["warn"], p["blue"], p["magenta"], p["cyan"], p["inkSoft"],
            p["inkFaint"], b["critical"], b["ok"], b["warn"], p["bblue"], p["bmagenta"], p["bcyan"], p["ink"]]


def load_tokens() -> dict:
    """The whole theme/tokens.json (read once, then kept)."""
    global _TOKENS
    if _TOKENS is None:
        with open(os.path.join(ROOT, "theme", "tokens.json")) as f:
            t = json.load(f)
        pal = t["palette"]
        assert set(pal["modes"]) >= set(MODES) and all(pal["modes"][m] in pal for m in MODES), "palette.modes must name palettes"
        assert pal["modes"]["light"] != pal["modes"]["dark"] and "night" not in (pal["modes"][m] for m in MODES), "light and dark are two palettes, night is no app mode"
        for m in MODES:
            assert all(HEX.fullmatch(pal[pal["modes"][m]].get(k, "")) for k in PALETTE_KEYS[:10]), f"palette of {m} misses a colour"
            assert all(HEX.fullmatch(pal["accents"][m].get(k, "")) for k in PALETTE_KEYS[10:]), f"accents of {m} miss a colour"
            assert set(pal["brights"][m]) == {"ok", "warn", "critical"}, f"brights of {m} must be ok, warn and critical"
            known = set(pal[pal["modes"][m]]) | set(pal["accents"][m])
            roles = pal["roles"]
            used = [roles["selection"]["bg"], roles["selection"]["fg"], roles["link"]] + list(roles["syntax"][m].values()) + roles["cavaGradient"]
            assert all(u in known for u in used), f"roles of {m} name an unknown colour"
            assert len(roles["syntax"][m]) == 8 and roles["cavaGradient"], "syntax roles and the cava gradient must be complete"
        assert pal["dark"]["bg"] == pal["day"]["ink"] and pal["dark"]["ink"] == pal["day"]["bg"], "dark.bg and dark.ink must mirror day"
        _TOKENS = t
    return _TOKENS


def colors_of(p: dict, mode: str) -> dict:
    """The flat role names for templates: every palette colour (bg, ink, ...), the accents (blue, ...), brights as
    bright_ok/bright_warn/bright_critical, selection_bg, selection_fg, link, syntax_NAME and cava_0, cava_1, ..."""
    assert mode in MODES, f"unknown mode {mode}"
    assert all(k in p for k in PALETTE_KEYS), f"palette misses {[k for k in PALETTE_KEYS if k not in p]}"
    assert all(HEX.fullmatch(p[k]) for k in PALETTE_KEYS), "palette colour is not #RRGGBB"
    assert (sum(int(p["bg"][i:i + 2], 16) for i in (1, 3, 5)) > sum(int(p["ink"][i:i + 2], 16) for i in (1, 3, 5))) == (mode == "light"), "light mode has a light background, dark mode a dark one"
    t = load_tokens()["palette"]
    c = {k: v for k, v in p.items() if k != "note"}
    c["mode"] = mode
    for k, v in t["brights"][mode].items():
        c["bright_" + k] = v
    roles = t["roles"]
    c["selection_bg"] = c[roles["selection"]["bg"]]
    c["selection_fg"] = c[roles["selection"]["fg"]]
    c["link"] = c[roles[ "link"]]
    for k, v in roles["syntax"][mode].items():
        c["syntax_" + k] = c[v]
    for i, v in enumerate(roles["cavaGradient"]):
        c["cava_%d" % i] = c[v]
    return c


def colors_all(p: dict, mode: str) -> dict:
    """colors_of(p, mode) plus every role of both palettes as light_ROLE and dark_ROLE (templates with both schemes)."""
    c = colors_of(p, mode)
    for m in MODES:
        for k, v in colors_of(palette(m), m).items():
            c[f"{m}_{k}"] = v
    return c


def hex_bare(color: str) -> str:
    """#RRGGBB as RRGGBB (Spicetify color.ini)."""
    assert HEX.fullmatch(color), f"not #RRGGBB: {color}"
    return color.lstrip("#")


def hex_rgba(color: str, alpha: float) -> str:
    """#RRGGBB and an alpha from 0 to 1 as RRGGBBAA; callers wrap it as rgba(RRGGBBAA) for Hyprland and hyprlock."""
    assert HEX.fullmatch(color), f"not #RRGGBB: {color}"
    assert isinstance(alpha, (int, float)) and not isinstance(alpha, bool) and 0 <= alpha <= 1, f"alpha outside 0 to 1: {alpha}"
    return color.lstrip("#") + "%02x" % round(alpha * 255)


def contrast(a: str, b: str) -> float:
    """WCAG contrast ratio of two #RRGGBB colours."""
    assert HEX.fullmatch(a) and HEX.fullmatch(b), f"not #RRGGBB: {a} {b}"
    def lum(h):
        v = [int(h[i:i + 2], 16) / 255 for i in (1, 3, 5)]
        v = [x / 12.92 if x <= 0.03928 else ((x + 0.055) / 1.055) ** 2.4 for x in v]
        return 0.2126 * v[0] + 0.7152 * v[1] + 0.0722 * v[2]
    hi, lo = sorted((lum(a), lum(b)), reverse=True)
    return (hi + 0.05) / (lo + 0.05)


def check_contrast(colors: dict) -> list:
    """Messages for the pairs below 4.5 (ink on bg, selection_fg on selection_bg, inkSoft on bg); empty when fine."""
    assert all(k in colors for k in ("ink", "bg", "inkSoft", "selection_fg", "selection_bg")), "colors comes from colors_of"
    pairs = [("ink", "bg"), ("selection_fg", "selection_bg"), ("inkSoft", "bg")]
    return [f"{a} on {b} has contrast {contrast(colors[a], colors[b]):.1f}" for a, b in pairs
            if contrast(colors[a], colors[b]) < 4.5]


def render_template(name: str, colors: dict, extra: dict = None) -> str:
    """Read theme/apps/NAME and replace every {{role}} with its colour from colors (and extra); {{role|bare}} drops
    the #, {{role|rgba:0.25}} gives RRGGBBAA ({{role|rgba:@name}} takes the alpha from extra). A role without a colour is an error."""
    assert name == os.path.basename(name) and name, f"template name must be a plain file name: {name}"
    assert os.path.isfile(os.path.join(TEMPLATES, name)), f"no template {name} in {TEMPLATES}"
    assert colors and not set(extra or {}) & set(colors), "extra must not replace a colour role"
    values = dict(colors)
    values.update(extra or {})
    with open(os.path.join(TEMPLATES, name)) as f:
        text = f.read()

    def one(m):
        role, _, flt = m.group(1).partition("|")
        if role not in values:
            raise KeyError(f"{name}: no colour for {{{{{role}}}}}")
        v = values[role]
        if flt == "bare":
            return hex_bare(v)
        if flt.startswith("rgba:"):
            a = flt[5:]
            return hex_rgba(v, float(values[a[1:]]) if a.startswith("@") else float(a))
        assert not flt, f"{name}: unknown filter {flt}"
        return v
    return re.sub(r"\{\{([^}]+)\}\}", one, text)


def template_roles(name: str) -> set:
    """The role names a template uses (to check them against colors_of before writing anything)."""
    assert name == os.path.basename(name) and name, f"template name must be a plain file name: {name}"
    with open(os.path.join(TEMPLATES, name)) as f:
        return {m.split("|")[0] for m in re.findall(r"\{\{([^}]+)\}\}", f.read())}


def profile_dirs(roots: list) -> list:
    """The profile folders (with prefs.js, not storage folders) below ROOTS; reads only, creates nothing."""
    assert isinstance(roots, list) and all(os.path.isabs(r) for r in roots), "roots are absolute paths"
    found = []
    for root in roots:
        for dirpath, dirs, files in os.walk(root):
            dirs[:] = [d for d in dirs if d not in ("storage", "chrome", "extensions")]
            if "prefs.js" in files:
                found.append(dirpath)
                dirs[:] = []
    return found


def enable_chrome_css(profile: str, dry: bool) -> None:
    """Make PROFILE load chrome/userChrome.css and userContent.css: the chrome folder, a user.js line for
    toolkit.legacyUserProfileCustomizations.stylesheets (the file is created if missing) and empty userChrome.css and
    userContent.css if they do not exist (callers add the @import line with ensure_line)."""
    assert dry or os.path.isdir(profile), f"no profile folder {profile}"
    assert "storage" not in profile.split(os.sep) and os.path.basename(profile.rstrip(os.sep)) != "chrome", "profile, not chrome or storage folder"
    if dry:
        print(f"  [dry-run] enable chrome css in {profile}")
        return
    chrome = os.path.join(profile, "chrome")
    userjs = os.path.join(profile, "user.js")
    line = 'user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);'
    os.makedirs(chrome, exist_ok=True)
    old = open(userjs).read() if os.path.exists(userjs) else ""
    if line not in old:
        with open(userjs, "w") as f:
            f.write(old.rstrip("\n") + ("\n" if old else "") + line + "\n")
    for name in ("userChrome.css", "userContent.css"):
        open(os.path.join(chrome, name), "a").close()


def ensure_block(path: str, marker: str, text: str, dry: bool) -> None:
    """Put TEXT between '# >>> MARKER' and '# <<< MARKER' lines in a config of the user (replace the block, or add it
    at the end), keeping a .before-aptus copy once; only for files with # comments (cava)."""
    assert re.fullmatch(r"[A-Za-z0-9_-]+", marker), f"marker must be one plain word: {marker}"
    assert f"# >>> {marker}" not in text and f"# <<< {marker}" not in text, "text must not contain its own markers"
    assert os.path.isabs(path), f"path must be absolute: {path}"
    assert not os.path.realpath(path).startswith(ROOT + os.sep), "never write a user config into the aptus repository"
    start, end = f"# >>> {marker}", f"# <<< {marker}"
    block = f"{start}\n{text.rstrip(chr(10))}\n{end}\n"
    old = open(path).read() if os.path.exists(path) else ""
    pat = re.compile(re.escape(start) + r".*?" + re.escape(end) + r"\n?", re.S)
    new = pat.sub(lambda m: block, old) if pat.search(old) else (old.rstrip("\n") + "\n\n" if old else "") + block
    if new == old:
        return
    if dry:
        print(f"  [dry-run] block {marker} in {path}")
        return
    os.makedirs(os.path.dirname(path), exist_ok=True)
    if old.strip() and not linked(path) and not os.path.exists(path + ".before-aptus"):
        shutil.copy2(path, path + ".before-aptus")
    with open(path, "w") as f:
        f.write(new)
    print(f"  updated {path}")


def ghostty_theme(p: dict, mode: str) -> str:
    """The text of the Ghostty theme file for the palette p of MODE (written as GHOSTTY_THEMES[mode])."""
    c = colors_of(p, mode)
    lines = [f"# {HEADER}", f"background = {p['bg']}", f"foreground = {p['ink']}", f"cursor-color = {p['ink']}",
             f"cursor-text = {p['bg']}", f"selection-background = {c['selection_bg']}", f"selection-foreground = {c['selection_fg']}"]
    lines += [f"palette = {i}={col}" for i, col in enumerate(ansi(p, mode))]
    return "\n".join(lines) + "\n"


def fastfetch_config(c: dict, dry: bool) -> None:
    """FASTFETCH_CONFIG: the user's config.jsonc (read through the dotfiles link) with the display colours of c; nothing is
    written to the dotfiles. fish.fish aliases fastfetch to it."""
    src = os.path.realpath(os.path.join(CFG, "fastfetch", "config.jsonc"))
    if not os.path.exists(src):
        return
    with open(src) as f:
        t = f.read()
    colors = {"keys": c["ink"], "title": c["ink"], "output": c["inkSoft"], "separator": c["inkFaint"], "keyColor": c["ink"]}
    for key, value in colors.items():
        t = re.sub(r'("%s"\s*:\s*)"#[0-9A-Fa-f]{6}"' % key, lambda m: m.group(1) + f'"{value}"', t)
    write(FASTFETCH_CONFIG, f"// {HEADER}\n" + t, dry)
    old = os.path.join(CFG, "fastfetch", "themes", "aptus.jsonc")
    if os.path.isfile(old) and not os.path.islink(old) and not dry:
        with open(old) as f:
            ours = HEADER in f.read(400)
        if ours:
            os.remove(old)


def fish_apply(c: dict, dry: bool) -> None:
    """Set the fish_color_* universal variables from the colours (fish is run once), so fish sessions that are already
    open change too; silent with dry, nothing happens if fish is missing. conf.d/aptus.fish (fish()) covers new sessions."""
    if dry or shutil.which("fish") is None:
        return
    text = render_template("fish-colors.fish", c)
    subprocess.run(["fish", "-c", text], check=False)


def spicetify_apply(mode: str, dry: bool) -> None:
    """If spicetify is installed: set color_scheme to MODE and apply (Spotify needs a restart); a failure is only reported;
    silent with dry. spotify() writes the theme files, this activates them."""
    if dry or shutil.which("spicetify") is None:
        return
    for args in (["config", "current_theme", SPICETIFY_THEME, "color_scheme", mode], ["apply"]):
        try:
            r = subprocess.run(["spicetify"] + args, check=False, capture_output=True, text=True, timeout=120)
        except (subprocess.TimeoutExpired, OSError) as e:
            print(f"  spicetify {' '.join(args)} failed: {e}", file=sys.stderr)
            return
        if r.returncode != 0:
            print(f"  spicetify {' '.join(args)} failed: {(r.stderr or r.stdout).strip()[:200]}", file=sys.stderr)
            return
    print("  spicetify applied (restart Spotify to see it)")


def xsettingsd(p, mode, dry):
    """XSETTINGS: Net/ThemeName adw-gtk3 or adw-gtk3-dark for X11 apps (the file is the user's, only that line changes)."""
    path = XSETTINGSD
    if not os.path.exists(path):
        return
    name = "adw-gtk3-dark" if mode == "dark" else "adw-gtk3"
    with open(path) as f:
        t = f.read()
    n = re.sub(r'^(Net/ThemeName\s+)"[^"]*"', lambda m: m.group(1) + f'"{name}"', t, flags=re.M)
    if n == t:
        return
    if dry:
        print(f"  [dry-run] Net/ThemeName {name} in {path}")
        return
    with open(os.path.realpath(path), "w") as f:
        f.write(n)
    print(f"  updated {path}")


def reload_apps(chosen: list, dry: bool) -> None:
    """Tell running programs to read their colours again (Hyprland reload, cava, nvim, kitty), where they can."""
    assert isinstance(chosen, list), "chosen is the list of app names"
    if dry:
        print("  [dry-run] reload running apps")
        return
    if "hyprland_look" in chosen and shutil.which("hyprctl"):
        subprocess.run(["hyprctl", "reload"], check=False, stdout=subprocess.DEVNULL)
    if shutil.which("pkill"):
        if "nvim" in chosen:
            subprocess.run(["pkill", "-USR1", "-x", "nvim"], check=False)
        if "xsettingsd" in chosen:
            subprocess.run(["pkill", "-HUP", "-x", "xsettingsd"], check=False)
        if "btop" in chosen:
            subprocess.run(["pkill", "-USR2", "-x", "btop"], check=False)
        if "cava" in chosen:
            subprocess.run(["pkill", "-USR2", "-x", "cava"], check=False)
        if "kitty" in chosen:
            subprocess.run(["pkill", "-USR1", "-x", "kitty"], check=False)


def linked(path: str) -> bool:
    """True if PATH or one of its folders is a link (a config kept in the dotfiles repo); the repo is the backup there."""
    return os.path.realpath(path) != os.path.abspath(path)


def ensure_css_import(path: str, line: str, dry: bool) -> None:
    """Put the @import LINE at the top of the CSS file at PATH (imports are ignored after other rules), once."""
    old = open(path).read() if os.path.exists(path) else ""
    if line in old:
        return
    keep = [l for l in old.split("\n") if l.startswith(("@charset", "@namespace"))]
    rest = "\n".join(l for l in old.split("\n") if l not in keep).lstrip("\n")
    new = "\n".join(keep + [line]) + "\n" + ("\n" + rest if rest else "")
    if dry:
        print(f"  [dry-run] add to {path}: {line}")
        return
    if old.strip() and not linked(path) and not os.path.exists(path + ".before-aptus"):
        shutil.copy2(path, path + ".before-aptus")
    with open(os.path.realpath(path), "w") as f:
        f.write(new)
    print(f"  updated {path}")


def write(path: str, text: str, dry: bool, keep: bool = True) -> None:
    if dry:
        print(f"  [dry-run] write {path}")
        return
    path = os.path.realpath(path) if os.path.islink(path) else path
    os.makedirs(os.path.dirname(path), exist_ok=True)
    if keep and os.path.exists(path) and not linked(path) and not os.path.exists(path + ".before-aptus"):
        with open(path) as f:
            old = f.read()
        if old.strip() and "aptus-theme-apps" not in old:
            shutil.copy2(path, path + ".before-aptus")
    tmp = path + ".aptus-tmp"
    with open(tmp, "w") as f:
        f.write(text)
    os.replace(tmp, path)
    print(f"  wrote {path}")


def ensure_line(path: str, line: str, dry: bool, drop: str = "") -> None:
    """Add LINE at the end of an existing config, once; lines matching DROP (a regex) are removed first."""
    if not os.path.exists(path):
        return
    with open(path) as f:
        text = f.read()
    new = re.sub(drop, "", text, flags=re.M) if drop else text
    if line not in new:
        new = new.rstrip("\n") + "\n\n" + line + "\n"
    if new == text:
        return
    if dry:
        print(f"  [dry-run] add to {path}: {line}")
        return
    if text.strip() and not linked(path) and not os.path.exists(path + ".before-aptus"):
        shutil.copy2(path, path + ".before-aptus")
    with open(path, "w") as f:
        f.write(new)
    print(f"  updated {path}")


HEADER = "aptus-theme-apps: generated from theme/tokens.json, do not edit (run aptus-theme-apps again)"


def kitty(p, mode, dry):
    a = ansi(p, mode)
    c = colors_of(p, mode)
    lines = [f"# {HEADER}", f"foreground {p['ink']}", f"background {p['bg']}", f"selection_foreground {c['selection_fg']}",
             f"selection_background {c['selection_bg']}", f"cursor {p['ink']}", f"cursor_text_color {p['bg']}",
             f"url_color {c['link']}", f"active_border_color {p['inkSoft']}", f"inactive_border_color {p['line']}",
             f"active_tab_foreground {p['bg']}", f"active_tab_background {p['ink']}",
             f"inactive_tab_foreground {p['inkSoft']}", f"inactive_tab_background {p['surfaceAlt']}",
             f"tab_bar_background {p['bg']}"]
    lines += [f"color{i} {c}" for i, c in enumerate(a)]
    write(os.path.join(CFG, "kitty", "themes", "aptus.conf"), "\n".join(lines) + "\n", dry)
    # include it after the other theme includes so it wins; the generated Noctalia block stays but is overridden
    ensure_line(os.path.join(CFG, "kitty", "kitty.conf"), "include themes/aptus.conf", dry)


def ghostty(p, mode, dry):
    for m in MODES:
        write(os.path.join(CFG, "ghostty", "themes", GHOSTTY_THEMES[m]), ghostty_theme(palette(m), m), dry)
    theme = f"theme = light:{GHOSTTY_THEMES['light']},dark:{GHOSTTY_THEMES['dark']}"
    ensure_line(os.path.join(CFG, "ghostty", "config"), theme, dry, drop=r"^theme\s*=.*\n?")


def btop(p, mode, dry):
    link = colors_of(p, mode)["link"]
    names = dict(main_bg=p["bg"], main_fg=p["ink"], title=p["ink"], hi_fg=link, selected_bg=p["ink"],
                 selected_fg=p["bg"], inactive_fg=p["inkFaint"], graph_text=p["inkSoft"], meter_bg=p["line"],
                 proc_misc=p["cyan"], cpu_box=p["line"], mem_box=p["line"], net_box=p["line"], proc_box=p["line"],
                 div_line=p["line"], temp_start=p["ok"], temp_mid=p["warn"], temp_end=p["critical"],
                 cpu_start=p["ok"], cpu_mid=p["warn"], cpu_end=p["critical"], free_start=p["ok"], free_mid=p["ok"],
                 free_end=p["ok"], cached_start=p["blue"], cached_mid=p["blue"], cached_end=p["blue"],
                 available_start=p["cyan"], available_mid=p["cyan"], available_end=p["cyan"],
                 used_start=p["warn"], used_mid=p["warn"], used_end=p["critical"],
                 download_start=p["blue"], download_mid=p["blue"], download_end=p["cyan"],
                 upload_start=p["magenta"], upload_mid=p["magenta"], upload_end=p["bmagenta"])
    text = f"# {HEADER}\n" + "".join(f'theme[{k}]="{v}"\n' for k, v in names.items())
    write(os.path.join(CFG, "btop", "themes", "aptus.theme"), text, dry)
    path = os.path.join(CFG, "btop", "btop.conf")
    if os.path.exists(path):
        with open(path) as f:
            t = f.read()
        n = re.sub(r'^color_theme\s*=.*$', 'color_theme = "aptus"', t, flags=re.M)
        if n != t and not dry:
            if not os.path.exists(path + ".before-aptus"):
                shutil.copy2(path, path + ".before-aptus")
            with open(path, "w") as f:
                f.write(n)
            print(f"  updated {path}")


def gtk(p, mode, dry):
    css = f"""/* {HEADER} */
@define-color accent_bg_color {p['ink']};
@define-color accent_fg_color {p['bg']};
@define-color accent_color {p['ink']};
@define-color window_bg_color {p['bg']};
@define-color window_fg_color {p['ink']};
@define-color view_bg_color {p['surface']};
@define-color view_fg_color {p['ink']};
@define-color headerbar_bg_color {p['bg']};
@define-color headerbar_fg_color {p['ink']};
@define-color headerbar_border_color {p['line']};
@define-color sidebar_bg_color {p['surfaceAlt']};
@define-color sidebar_fg_color {p['ink']};
@define-color card_bg_color {p['surface']};
@define-color card_fg_color {p['ink']};
@define-color popover_bg_color {p['surface']};
@define-color popover_fg_color {p['ink']};
@define-color dialog_bg_color {p['surface']};
@define-color dialog_fg_color {p['ink']};
@define-color success_color {p['ok']};
@define-color warning_color {p['warn']};
@define-color error_color {p['critical']};
@define-color destructive_bg_color {p['critical']};
@define-color borders {p['line']};
@define-color theme_bg_color {p['bg']};
@define-color theme_fg_color {p['ink']};
@define-color theme_base_color {p['surface']};
@define-color theme_text_color {p['ink']};
@define-color theme_selected_bg_color {p['ink']};
@define-color theme_selected_fg_color {p['bg']};
"""
    for v in ("gtk-3.0", "gtk-4.0"):
        d = os.path.join(CFG, v)
        write(os.path.join(d, "aptus-colors.css"), css, dry)
        write(os.path.join(d, "gtk.css"), f'/* {HEADER} */\n@import url("aptus-colors.css");\n', dry)


def qt(p, mode, dry):
    def pal(fg, btn, base, win, hi, hifg, dis):
        order = [fg, btn, p["surface"], p["surfaceAlt"], p["line"], p["inkFaint"], fg, p["bg"], fg, base, win, "#000000",
                 hi, hifg, p["blue"], p["magenta"], p["surfaceAlt"], "#000000", p["surface"], fg, dis, hi]
        return ", ".join("#ff" + c.lstrip("#") for c in order)
    active = pal(p["ink"], p["surfaceAlt"], p["surface"], p["bg"], p["ink"], p["bg"], p["inkFaint"])
    disabled = pal(p["inkFaint"], p["surfaceAlt"], p["surface"], p["bg"], p["line"], p["inkFaint"], p["inkFaint"])
    text = f"# {HEADER}\n[ColorScheme]\nactive_colors={active}\ninactive_colors={active}\ndisabled_colors={disabled}\n"
    for v in ("qt5ct", "qt6ct"):
        path = os.path.join(CFG, v, "colors", "aptus.conf")
        write(path, text, dry)
        conf = os.path.join(CFG, v, f"{v}.conf")
        if os.path.exists(conf):
            with open(conf) as f:
                t = f.read()
            n = re.sub(r'^color_scheme_path=.*$', f"color_scheme_path={path}", t, flags=re.M)
            n = re.sub(r'^style=.*$', "style=Fusion", n, flags=re.M)
            n = re.sub(r'^icon_theme=.*$', "icon_theme=Papirus" + ("-Dark" if mode == "dark" else ""), n, flags=re.M)
            if n != t and not dry:
                if not os.path.exists(conf + ".before-aptus"):
                    shutil.copy2(conf, conf + ".before-aptus")
                with open(conf, "w") as f:
                    f.write(n)
                print(f"  updated {conf}")


def zathura(p, mode, dry):
    c = colors_of(p, mode)
    path = os.path.join(CFG, "zathura", "zathurarc")
    text = f"# {HEADER}\nset default-bg \"{p['bg']}\"\nset default-fg \"{p['ink']}\"\nset statusbar-bg \"{p['surfaceAlt']}\"\n" \
           f"set statusbar-fg \"{p['ink']}\"\nset inputbar-bg \"{p['bg']}\"\nset inputbar-fg \"{p['ink']}\"\n" \
           f"set highlight-color \"{c['line']}\"\nset highlight-active-color \"{c['inkFaint']}\"\nset recolor \"false\"\n"
    if os.path.isdir(os.path.join(CFG, "zathura")):
        write(os.path.join(CFG, "zathura", "aptus"), text, dry)
        ensure_line(path, "include aptus", dry)


def gsettings(p, mode, dry):
    pairs = [("color-scheme", "prefer-dark" if mode == "dark" else "prefer-light"),
             ("gtk-theme", "adw-gtk3-dark" if mode == "dark" else "adw-gtk3"),
             ("icon-theme", "Papirus-Dark" if mode == "dark" else "Papirus")]
    if shutil.which("gsettings") is None:
        return
    for key, val in pairs:
        if dry:
            print(f"  [dry-run] gsettings set org.gnome.desktop.interface {key} {val}")
        else:
            subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", key, val], check=False)
    print("  set gsettings color-scheme, gtk-theme, icon-theme")


def starship(p, mode, dry):
    """CFG/starship/aptus.toml (flat segments, palette aptus); fish selects it with STARSHIP_CONFIG, starship.toml itself is not touched."""
    assert mode in MODES and all(k in p for k in PALETTE_KEYS), "palette comes from palette(mode)"
    assert isinstance(dry, bool) and os.path.isabs(CFG) and os.path.isabs(STATE), "XDG folders must be absolute paths"
    write(os.path.join(CFG, "starship", "aptus.toml"), render_template("starship.toml", colors_of(p, mode)), dry)


def fish(p, mode, dry):
    """CFG/fish/conf.d/aptus.fish (fish_color_*, STARSHIP_CONFIG) and the STARSHIP_CONFIG line of config.fish, which runs later."""
    c = colors_of(p, mode)
    target = os.path.join(CFG, "starship", "aptus.toml")
    extra = {"starship_path": target, "fastfetch_config": FASTFETCH_CONFIG}
    write(os.path.join(CFG, "fish", "conf.d", "aptus.fish"), render_template("fish.fish", c, extra), dry)
    fish_apply(c, dry)
    path = os.path.join(CFG, "fish", "config.fish")
    if not os.path.exists(path):
        return
    with open(path) as f:
        t = f.read()
    n = re.sub(r'^(\s*set -gx STARSHIP_CONFIG ).*$', lambda m: m.group(1) + f'"{target}"', t, flags=re.M)
    if n == t:
        return
    if dry:
        print(f"  [dry-run] point STARSHIP_CONFIG in {path} at {target}")
        return
    if not linked(path) and not os.path.exists(path + ".before-aptus"):
        shutil.copy2(path, path + ".before-aptus")
    with open(os.path.realpath(path), "w") as f:
        f.write(n)
    print(f"  updated {path}")


def nvim(p, mode, dry):
    """Neovim colorscheme aptus in ~/.local/share/nvim/site/colors/aptus.lua (not in ~/.config/nvim, which is a link into the dotfiles)."""
    assert mode in MODES and all(k in p for k in PALETTE_KEYS), "palette comes from palette(mode)"
    assert isinstance(dry, bool) and os.path.isabs(CFG) and os.path.isabs(STATE), "XDG folders must be absolute paths"
    path = os.path.join(HOME, ".local", "share", "nvim", "site", "colors", "aptus.lua")
    write(path, render_template("nvim-colors.lua", colors_of(p, mode)), dry)


def yazi(p, mode, dry):
    for m in MODES:
        write(os.path.join(CFG, "yazi", "flavors", YAZI_FLAVORS[m] + ".yazi", "flavor.toml"),
              render_template("yazi-flavor.toml", colors_of(palette(m), m)), dry)
    path = os.path.join(CFG, "yazi", "theme.toml")
    flavor = f'[flavor]\ndark = "{YAZI_FLAVORS["dark"]}"\nlight = "{YAZI_FLAVORS["light"]}"\n'
    t = open(path).read() if os.path.exists(path) else ""
    if re.search(r"^\[flavor\]", t, flags=re.M):
        n = re.sub(r"(^\[flavor\][^\[]*)", lambda m: re.sub(r"^(dark|light)\s*=.*$", lambda k: f'{k.group(1)} = "{YAZI_FLAVORS[k.group(1)]}"', m.group(1), flags=re.M), t, flags=re.M)
    else:
        n = (t.rstrip("\n") + "\n\n" if t.strip() else "") + flavor
    if n == t:
        return
    if dry:
        print(f"  [dry-run] select the aptus flavors in {path}")
        return
    if t.strip() and not linked(path) and not os.path.exists(path + ".before-aptus"):
        shutil.copy2(path, path + ".before-aptus")
    with open(os.path.realpath(path), "w") as f:
        f.write(n)
    print(f"  updated {path}")


def fastfetch(p, mode, dry):
    """fastfetch_config(c, dry); config.jsonc is a link into the dotfiles and is not touched."""
    assert mode in MODES and all(k in p for k in PALETTE_KEYS), "palette comes from palette(mode)"
    assert isinstance(dry, bool) and os.path.isabs(CFG) and os.path.isabs(STATE), "XDG folders must be absolute paths"
    fastfetch_config(colors_of(p, mode), dry)


def cava(p, mode, dry):
    """CFG/cava/themes/aptus and 'theme = aptus' in the [color] section of CFG/cava/config (a block if there is none)."""
    write(os.path.join(CFG, "cava", "themes", "aptus"), render_template("cava.theme", colors_of(p, mode)), dry)
    path = os.path.join(CFG, "cava", "config")
    old = open(path).read() if os.path.exists(path) else ""
    if not re.search(r"^\[color\]", old, flags=re.M):
        ensure_block(path, "aptus-theme-apps", "[color]\ntheme = 'aptus'", dry)
        return
    new = re.sub(r"^theme\s*=.*\n", "", old, flags=re.M)
    new = re.sub(r"^\[color\]\n", "[color]\ntheme = 'aptus'\n", new, count=1, flags=re.M)
    if new == old:
        return
    if dry:
        print(f"  [dry-run] theme aptus in {path}")
        return
    if not linked(path) and not os.path.exists(path + ".before-aptus"):
        shutil.copy2(path, path + ".before-aptus")
    with open(os.path.realpath(path), "w") as f:
        f.write(new)
    print(f"  updated {path}")


def hyprland_look(p, mode, dry):
    """HYPR_COLORS, a Lua file that returns { activeBorder, inactiveBorder, shadow } as "rgba(RRGGBBAA)" strings (the ink with
    the BORDER and SHADOW alphas); aptus-look.lua reads it with dofile."""
    assert mode in MODES and all(k in p for k in PALETTE_KEYS), "palette comes from palette(mode)"
    assert isinstance(dry, bool) and os.path.isabs(CFG) and os.path.isabs(STATE), "XDG folders must be absolute paths"
    alphas = {"border_active": BORDER_ALPHA_ACTIVE, "border_inactive": BORDER_ALPHA_INACTIVE, "shadow": SHADOW_ALPHA}
    alphas["shadow_base"] = "#000000"
    write(HYPR_COLORS, render_template("hyprland-colors.lua", colors_of(p, mode), alphas), dry)


def hyprlock(p, mode, dry):
    """HYPRLOCK_COLORS: $aptus_bg, $aptus_ink, $aptus_line plus the variables the user's hyprlock.conf uses ($text_color,
    $entry_background_color, $entry_border_color, $entry_color, $primary, $error); its source line goes after the last
    existing source line, so the new values win."""
    assert mode in MODES and all(k in p for k in PALETTE_KEYS), "palette comes from palette(mode)"
    assert isinstance(dry, bool) and os.path.isabs(CFG) and os.path.isabs(STATE), "XDG folders must be absolute paths"
    write(HYPRLOCK_COLORS, render_template("hyprlock-colors.conf", colors_of(p, mode)), dry)
    path = os.path.join(CFG, "hypr", "hyprlock.conf")
    if not os.path.exists(path):
        return
    line = f"source = {HYPRLOCK_COLORS}"
    with open(path) as f:
        text = f.read()
    if line in text:
        return
    if dry:
        print(f"  [dry-run] add to {path}: {line}")
        return
    lines = text.split("\n")
    last = max((i for i, l in enumerate(lines) if l.startswith("source")), default=-1)
    lines.insert(last + 1, line)
    if not linked(path) and not os.path.exists(path + ".before-aptus"):
        shutil.copy2(path, path + ".before-aptus")
    with open(path, "w") as f:
        f.write("\n".join(lines))
    print(f"  updated {path}")


def zen(p, mode, dry):
    """userChrome.css and userContent.css in every Zen profile."""
    assert mode in MODES and all(k in p for k in PALETTE_KEYS), "palette comes from palette(mode)"
    assert isinstance(dry, bool) and os.path.isabs(CFG) and os.path.isabs(STATE), "XDG folders must be absolute paths"
    c = colors_all(p, mode)
    profs = profile_dirs([r for r in [ZEN_ROOT] if os.path.isdir(r)])
    if not profs:
        print("  no zen profile found (start it once, then run this again)")
    for prof in profs:
        enable_chrome_css(prof, dry)
        chrome = os.path.join(prof, "chrome")
        write(os.path.join(chrome, "aptus-chrome.css"), render_template("zen-chrome.css", c), dry)
        write(os.path.join(chrome, "aptus-content.css"), render_template("zen-content.css", c), dry)
        if not dry:
            ensure_css_import(os.path.join(chrome, "userChrome.css"), '@import url("aptus-chrome.css");', dry)
            ensure_css_import(os.path.join(chrome, "userContent.css"), '@import url("aptus-content.css");', dry)


def thunderbird(p, mode, dry):
    """userChrome.css and userContent.css in every Thunderbird profile (nothing if there is none yet)."""
    assert mode in MODES and all(k in p for k in PALETTE_KEYS), "palette comes from palette(mode)"
    assert isinstance(dry, bool) and os.path.isabs(CFG) and os.path.isabs(STATE), "XDG folders must be absolute paths"
    c = colors_all(p, mode)
    profs = profile_dirs([r for r in THUNDERBIRD_ROOTS if os.path.isdir(r)])
    if not profs:
        print("  no thunderbird profile found (start it once, then run this again)")
    for prof in profs:
        enable_chrome_css(prof, dry)
        chrome = os.path.join(prof, "chrome")
        write(os.path.join(chrome, "aptus-chrome.css"), render_template("thunderbird-chrome.css", c), dry)
        write(os.path.join(chrome, "aptus-content.css"), render_template("thunderbird-content.css", c), dry)
        if not dry:
            ensure_css_import(os.path.join(chrome, "userChrome.css"), '@import url("aptus-chrome.css");', dry)
            ensure_css_import(os.path.join(chrome, "userContent.css"), '@import url("aptus-content.css");', dry)


def spotify(p, mode, dry):
    """Spicetify theme SPICETIFY_THEME (color.ini and user.css), written even if Spicetify is not installed yet; applying it is left to the user."""
    assert mode in MODES and all(k in p for k in PALETTE_KEYS), "palette comes from palette(mode)"
    assert isinstance(dry, bool) and os.path.isabs(CFG) and os.path.isabs(STATE), "XDG folders must be absolute paths"
    c = colors_all(p, mode)
    d = os.path.join(SPICETIFY_DIR, SPICETIFY_THEME)
    write(os.path.join(d, "color.ini"), render_template("spicetify-color.ini", c), dry)
    write(os.path.join(d, "user.css"), render_template("spicetify-user.css", c), dry)
    spicetify_apply(mode, dry)


# The first seven are the old default; the others change files outside the shell (browser, mail, Spotify, prompt, editor,
# lock screen) and run only with --only or --all.
DEFAULT_APPS = ["kitty", "ghostty", "btop", "gtk", "qt", "zathura", "gsettings", "xsettingsd"]
APPS = dict(kitty=kitty, ghostty=ghostty, btop=btop, gtk=gtk, qt=qt, zathura=zathura, gsettings=gsettings, xsettingsd=xsettingsd,
            starship=starship, fish=fish, nvim=nvim, yazi=yazi, fastfetch=fastfetch, cava=cava, hyprland_look=hyprland_look,
            hyprlock=hyprlock, zen=zen, thunderbird=thunderbird, spotify=spotify)


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--mode", choices=list(MODES), default="light")
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--only", default=",".join(DEFAULT_APPS), help="comma separated apps (default: the terminal and toolkit apps)")
    ap.add_argument("--all", action="store_true", help="every app, including browser, mail, Spotify, prompt, editor and lock screen")
    ap.add_argument("--quiet", action="store_true", help="print nothing but errors")
    ap.add_argument("--if-changed", action="store_true", help="do nothing if the last run (all apps) was for the same mode")
    args = ap.parse_args()
    chosen = list(APPS) if args.all else [a for a in args.only.split(",") if a]
    if not chosen or len(set(chosen)) != len(chosen):
        print("--only needs at least one app, each once", file=sys.stderr)
        return 2
    for a in chosen:
        if a not in APPS:
            print(f"unknown app {a}; known: {', '.join(APPS)}", file=sys.stderr)
            return 2
    for var in ("XDG_CONFIG_HOME", "XDG_STATE_HOME"):
        if os.environ.get(var) and not os.path.isabs(os.environ[var]):
            print(f"{var} must be an absolute path", file=sys.stderr)
            return 2
    if args.if_changed and os.path.exists(MODE_FILE) and open(MODE_FILE).read().strip() == args.mode:
        return 0
    p = palette(args.mode)
    c = colors_all(p, args.mode)
    for message in check_contrast(c):
        print(f"warning: {message}", file=sys.stderr)
    missing = {r for t in sorted(os.listdir(TEMPLATES)) for r in template_roles(t)} - set(c) - {"starship_path", "fastfetch_config", "shadow_base"}
    if missing:
        print(f"templates use roles without a colour: {', '.join(sorted(missing))}", file=sys.stderr)
        return 2
    with contextlib.redirect_stdout(open(os.devnull, "w") if args.quiet else sys.stdout):
        for a in chosen:
            print(f"{a}:")
            APPS[a](p, args.mode, args.dry_run)
        reload_apps(chosen, args.dry_run)
    if args.all and not args.dry_run:
        os.makedirs(os.path.dirname(MODE_FILE), exist_ok=True)
        with open(MODE_FILE, "w") as f:
            f.write(args.mode + "\n")
    return 0


sys.exit(main())

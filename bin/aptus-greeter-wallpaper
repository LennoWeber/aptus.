#!/usr/bin/env python3
"""Set the picture of the aptus login screen. Runs as root through pkexec (installed to /usr/local/bin by install.sh --greeter).

    aptus-greeter-wallpaper PATH [--fit FIT]   copy the picture to /usr/local/share/aptus and point greeter.json at it
                                               (FIT: fill, fit, stretch, center or tile; default: leave the config's fit as it is)
    aptus-greeter-wallpaper --clear            remove the picture

The caller is not trusted: PATH is read with the caller's own rights (never as root), must be a jpg, png or webp
and at most 32 MB. Nothing else is written."""
import json
import os
import pwd
import subprocess
import sys

SHARE = "/usr/local/share/aptus"
CONFIG = "/etc/aptus/greeter.json"
MAX_BYTES = 32 * 1024 * 1024
TARGET_PREFIX = "wallpaper"
FITS = ("fill", "fit", "stretch", "center", "tile")


def fail(message):
    print("aptus-greeter-wallpaper: " + message, file=sys.stderr)
    sys.exit(1)


def extension_of(data):
    if data[:3] == b"\xff\xd8\xff":
        return ".jpg"
    if data[:8] == b"\x89PNG\r\n\x1a\n":
        return ".png"
    if data[:4] == b"RIFF" and data[8:12] == b"WEBP":
        return ".webp"
    return None


def write_atomic(path, data, mode):
    tmp = path + ".tmp"
    with open(tmp, "wb") as f:
        f.write(data)
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def remove_old():
    for name in os.listdir(SHARE):
        if name.startswith(TARGET_PREFIX + "."):
            os.remove(os.path.join(SHARE, name))


def parse_args(argv):
    """(path, clear, fit) from the command line: path is None with --clear, fit is None when --fit is not given.
    Anything else ends the program with the usage message."""
    assert isinstance(argv, list), "argv is a list"
    usage = "usage: aptus-greeter-wallpaper PATH [--fit FIT] | --clear"
    args = list(argv)
    fit = None
    if "--fit" in args:
        i = args.index("--fit")
        if i + 1 >= len(args) or args[i + 1] not in FITS:
            fail("--fit needs one of " + ", ".join(FITS))
        fit = args[i + 1]
        del args[i:i + 2]
    if len(args) != 1:
        fail(usage)
    if args[0] == "--clear":
        if fit is not None:
            fail(usage)
        return None, True, None
    return args[0], False, fit


def set_config(wallpaper, fit=None):
    assert fit is None or fit in FITS, "fit is one of " + ", ".join(FITS)
    with open(CONFIG, encoding="utf-8") as f:
        config = json.load(f)
    config["wallpaper"] = wallpaper
    if fit is not None:
        config["wallpaperFit"] = fit
    write_atomic(CONFIG, (json.dumps(config, indent=2) + "\n").encode(), 0o644)


def main():
    if os.geteuid() != 0:
        fail("must run as root (use pkexec)")
    path, clear, fit = parse_args(sys.argv[1:])
    if not os.path.isdir(SHARE) or not os.path.isfile(CONFIG):
        fail("the aptus greeter is not installed (install.sh --greeter)")

    if clear:
        remove_old()
        set_config("")
        return

    # Read as the user who asked, so this cannot be used to read files that user may not read.
    uid = int(os.environ.get("PKEXEC_UID", "-1"))
    if uid < 0:
        fail("PKEXEC_UID is not set (run through pkexec)")
    gid = pwd.getpwuid(uid).pw_gid
    read = subprocess.run(
        ["setpriv", "--reuid", str(uid), "--regid", str(gid), "--clear-groups",
         "head", "-c", str(MAX_BYTES + 1), "--", path],
        capture_output=True)
    if read.returncode != 0:
        fail("cannot read " + path)
    data = read.stdout
    if len(data) > MAX_BYTES:
        fail("picture is larger than 32 MB")
    ext = extension_of(data)
    if ext is None:
        fail("not a jpg, png or webp picture")

    remove_old()
    target = os.path.join(SHARE, TARGET_PREFIX + ext)
    write_atomic(target, data, 0o644)
    set_config(target, fit)


main()

#!/usr/bin/env bash
# List and check the packages aptus needs, and print the install command. It never installs anything.
#
#   aptus-packages list [GROUP...]      print the package names of the groups (default: required session backup)
#   aptus-packages missing [GROUP...]   print the ones rpm does not know
#   aptus-packages command [GROUP...]   print the sudo dnf command for the missing ones
#   aptus-packages check                report what is installed and what is missing, per group
#   aptus-packages apps [list|missing|command|check] [GROUP...]
#                                       the same for the apps of the dotfiles (packages/aptus-apps.txt); the group
#                                       flatpak is installed with flatpak, the others with dnf

set -u

ROOT="$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")"
LIST_FILE="$ROOT/packages/aptus-dnf.txt"
APPS_FILE="$ROOT/packages/aptus-apps.txt"
DEFAULT_GROUPS=(required session backup)

# Print the package names of the given groups (default groups when none) from LIST_FILE, one per line.
list_packages() {
    local groups=("$@")
    [ "${#groups[@]}" -gt 0 ] || groups=("${DEFAULT_GROUPS[@]}")
    [ -r "$LIST_FILE" ] || { echo "aptus-packages: cannot read $LIST_FILE" >&2; return 1; }
    awk -v wanted="${groups[*]}" '
        BEGIN { n = split(wanted, w, " "); for (i = 1; i <= n; i++) ok[w[i]] = 1 }
        /^##[ \t]+/ { group = $2; next }
        { sub(/#.*/, ""); gsub(/[ \t]+/, "") }
        $0 != "" && ok[group] { print $0 }
    ' "$LIST_FILE"
}

# The names from list_packages that rpm does not know.
missing_packages() {
    local name
    local alt found
    while IFS= read -r name; do
        found=0
        for alt in ${name//|/ }; do
            rpm -q "$alt" >/dev/null 2>&1 && found=1
        done
        [ "$found" = 1 ] || printf '%s\n' "$name"
    done < <(list_packages "$@")
}

# The sudo dnf command for the missing packages, or a line saying that nothing is missing. It only prints.
install_command() {
    local missing=() name
    mapfile -t missing < <(missing_packages "$@")
    if [ "${#missing[@]}" -eq 0 ]; then echo "Nothing is missing."; return 0; fi
    local first=()
    for name in "${missing[@]}"; do first+=("${name%%|*}"); done
    echo "sudo dnf install -y ${first[*]}"
}

# Per group: how many packages are installed, and which are missing.
check_all() {
    local group missing
    for group in required session backup optional; do
        missing="$(missing_packages "$group" | tr '\n' ' ')"
        if [ -z "$missing" ]; then echo "$group: all installed"; else echo "$group: missing $missing"; fi
    done
}

# All group names of a list file, in order.
group_names() {
    awk '/^##[ \t]+/ { print $2 }' "$1"
}

# apps: the apps file with the same sub-commands. Flatpak ids go to flatpak, the rest to dnf.
apps() {
    local sub="${1:-check}" LIST_FILE="$APPS_FILE" group
    [ "$#" -gt 0 ] && shift
    local groups=("$@")
    [ "${#groups[@]}" -gt 0 ] || mapfile -t groups < <(group_names "$APPS_FILE")
    local dnf_groups=() g
    for g in "${groups[@]}"; do [ "$g" = flatpak ] || dnf_groups+=("$g"); done
    case "$sub" in
        list) list_packages "${groups[@]}" ;;
        missing)
            [ "${#dnf_groups[@]}" -gt 0 ] && missing_packages "${dnf_groups[@]}"
            ;;
        command)
            [ "${#dnf_groups[@]}" -gt 0 ] && install_command "${dnf_groups[@]}"
            if printf '%s\n' "${groups[@]}" | grep -qx flatpak; then
                local ids=()
                mapfile -t ids < <(list_packages flatpak)
                echo "flatpak install -y flathub ${ids[*]}"
            fi
            ;;
        check)
            for g in "${groups[@]}"; do
                if [ "$g" = flatpak ]; then
                    local miss="" id
                    for id in $(list_packages flatpak); do flatpak info "$id" >/dev/null 2>&1 || miss="$miss $id"; done
                    if [ -z "$miss" ]; then echo "$g: all installed"; else echo "$g: missing$miss"; fi
                    continue
                fi
                local m
                m="$(missing_packages "$g" | tr '\n' ' ')"
                if [ -z "$m" ]; then echo "$g: all installed"; else echo "$g: missing $m"; fi
            done
            ;;
        *) echo "aptus-packages apps: unknown sub-command $sub" >&2; return 2 ;;
    esac
}

main() {
    local cmd="${1:-check}"
    [ "$#" -gt 0 ] && shift
    case "$cmd" in
        list) list_packages "$@" ;;
        missing) missing_packages "$@" ;;
        command) install_command "$@" ;;
        check) check_all ;;
        apps) apps "$@" ;;
        *) sed -n '2,8p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; return 2 ;;
    esac
}

main "$@"

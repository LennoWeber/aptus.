#!/usr/bin/bash
# tests/run: every test level of 07 §13 that runs without hands.
#   tests/run       pytest tests/unit, qmltestrunner on tests/qml, tests/lint.sh
#   tests/run e2e   the same plus pytest tests/e2e (nested Hyprland)
# pytest: $APTUS_PYTEST (e.g. a venv's "python -m pytest") or the system python3 -m pytest.
set -uo pipefail

repo="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
cd "$repo"
read -r -a pytest <<< "${APTUS_PYTEST:-python3 -m pytest}"
failed=()

echo "== pytest tests/unit"
"${pytest[@]}" -q tests/unit || failed+=("unit")

echo "== qmltestrunner tests/qml"
# The QML tests import the mock dir of tests/qml/mkmock.py (doubles of Quickshell, the real core
# singletons); its FileView reads through a file XHR.
mock="$(mktemp -d)"
trap 'rm -rf "$mock"' EXIT
if python3 tests/qml/mkmock.py "$mock/import"; then
    QML_XHR_ALLOW_FILE_READ=1 QT_QPA_PLATFORM=offscreen /usr/lib64/qt6/bin/qmltestrunner \
        -import "$mock/import" -input tests/qml || failed+=("qml")
else
    failed+=("qml")
fi

echo "== tests/lint.sh"
bash tests/lint.sh || failed+=("lint")

if [[ "${1:-}" == "e2e" ]]; then
    echo "== pytest tests/e2e"
    "${pytest[@]}" -q tests/e2e || failed+=("e2e")
fi

if (( ${#failed[@]} )); then
    echo "FAILED: ${failed[*]}"
    exit 1
fi
echo "all passed"
